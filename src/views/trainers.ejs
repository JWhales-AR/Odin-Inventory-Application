<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <link href="/style.css" rel="stylesheet">
    <title>Pokémon Manager</title>
  </head>
  <body>
    <header>
      <%- include('partials/navbar', { navLinks }) %>
    </header>
    <main>
      <div class="trainer-list">
        <% if (trainers.length !== 0) { %>
          <h1 class="centered-heading">Pokémon Trainers</h1>
          <%- include('partials/trainers', { trainers }) %>
        <% } else { %>
          <p>No Trainers in DB</p>
        <% } %>
      </div>
      <div class="trainer-add-redirect-button__container">
        <button onclick="location.href='/trainers/new'" class="trainer-add-redirect-button">+ Trainer</button>
      </div>
    </main>
  </body>
</html>
