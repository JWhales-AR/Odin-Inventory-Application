<div class="pokemon-list">
  <% if (pokemon.length !== 0) { %>
    <h1 class="centered-heading">
      <%= heading?? "Pokemon" %>
    </h1>
    <ul class="pokemon-list__inner">
      <% pokemon.forEach((monster) => { %>
        <li class="pokemon-list__item">
          <%= monster.species %>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No Pokemon in DB</p>
  <% } %>
</div>
