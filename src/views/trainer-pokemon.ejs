<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta
      name="viewport"
      content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0"
    >
    <link href="/style.css" rel="stylesheet">
    <link href="/favicon.svg" type="image/svg+xml" rel="icon">
    <title>Pokémon Manager</title>
  </head>
  <body>
    <header>
      <%- include('partials/navbar', { navLinks }) %>
    </header>
    <main>
      <%- include('partials/pokemon-list', { heading: listHeading }) %>
      <div class="pokemon-add-redirect-button__container">
        <button
          onclick="location.href='<%= trainerId %>/new'"
          class="pokemon-add-redirect-button"
        >+ Pokemon</button>
      </div>
    </main>
  </body>
</html>
